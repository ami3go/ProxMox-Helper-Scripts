HELPER_ID="ai-dev-lxc"
HELPER_NAME="AI Development LXC"
HELPER_CATEGORY="development"
HELPER_VERSION="2.2.7"
HELPER_DESCRIPTION="Create and provision a headless AI development LXC with selectable AI coding agents, code-server, FileBrowser Quantum, Termix, and Robot Framework. See extend-existing-lxc.sh to add Codex CLI, Homepage, and Caddy to an LXC this helper already created."
HELPER_ENTRYPOINT="install.sh"
HELPER_TARGET="proxmox-host"
HELPER_TAGS="ai,development,lxc,codex,caddy,homepage,code-server,termix,filebrowser"
HELPER_MAINTAINER="Repository maintainers"
HELPER_DOCS="README.md"
HELPER_STANDALONE="true"
